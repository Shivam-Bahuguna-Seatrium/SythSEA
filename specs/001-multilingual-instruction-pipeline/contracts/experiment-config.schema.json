{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthsea.org/schemas/experiment-config.schema.json",
  "title": "SynthSEA Experiment Configuration",
  "type": "object",
  "required": ["experiment_id", "condition_id", "language_profiles", "dataset_versions", "seeds", "metrics"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "language_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dataset_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "models": {"type": "array", "items": {"type": "string"}},
    "prompts": {"type": "array", "items": {"type": "string"}},
    "code_switching": {
      "type": "object",
      "required": ["enabled", "condition"],
      "properties": {
        "enabled": {"type": "boolean"},
        "condition": {"type": "string"},
        "direction": {"type": "string"},
        "target_proportion": {"type": "number", "minimum": 0, "maximum": 1},
        "intent": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_review": {"type": "boolean"},
    "data_efficiency_size": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}