{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthsea.local/contracts/evidence-matrix.schema.json",
  "title": "SynthSEA Claim Evidence Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_id", "version", "claims", "generated_at"],
  "properties": {
    "matrix_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_text", "evidence_ids", "source_ids", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "language_slices": {"type": "array", "items": {"type": "string"}},
          "transformation": {"type": "string"},
          "status": {"enum": ["verified", "missing", "unsupported", "restricted", "excluded", "blocked"]},
          "review_notes": {"type": "string"}
        }
      }
    }
  }
}