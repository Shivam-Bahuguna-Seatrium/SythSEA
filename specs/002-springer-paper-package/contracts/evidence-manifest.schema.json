{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthsea.org/schemas/evidence-manifest.schema.json",
  "title": "SynthSEA Paper Evidence Manifest",
  "type": "object",
  "required": ["manifest_id", "manifest_version", "artifact_refs", "experiment_ids", "language_profiles", "conditions", "checksums", "access_summary", "limitations", "verification_status"],
  "properties": {
    "manifest_id": {"type": "string"},
    "manifest_version": {"type": "string"},
    "source_root": {"type": "string"},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experiment_ids": {"type": "array", "items": {"type": "string"}},
    "language_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "checksums": {"type": "object", "additionalProperties": {"type": "string"}},
    "access_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "verification_status": {"enum": ["verified", "missing", "inconsistent", "restricted", "blocked"]}
  },
  "additionalProperties": false
}
